{
  "name": "cybertrace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:backend": "vitest run tests/backend",
    "test:frontend": "vitest run tests/frontend",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@prisma/client": "^6.19.0", "@xyflow/react": "^12.9.0", "bcryptjs": "^3.0.3", "cors": "^2.8.5", "dotenv": "^16.6.1", "express": "^5.1.0", "express-rate-limit": "^8.2.1", "helmet": "^8.1.0", "jsonwebtoken": "^9.0.2", "leaflet": "^1.9.4", "lucide-react": "^0.468.0", "react": "^19.1.1", "react-dom": "^19.1.1", "react-leaflet": "^5.0.0", "react-router-dom": "^7.8.2", "recharts": "^3.1.2", "zod": "^4.1.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0", "@testing-library/react": "^16.3.0", "@types/cors": "^2.8.19", "@types/express": "^5.0.3", "@types/jsonwebtoken": "^9.0.10", "@types/leaflet": "^1.9.20", "@types/node": "^24.3.0", "@types/react": "^19.1.10", "@types/react-dom": "^19.1.7", "@types/supertest": "^6.0.3", "@vitejs/plugin-react": "^5.0.2", "autoprefixer": "^10.4.21", "concurrently": "^9.2.1", "jsdom": "^26.1.0", "postcss": "^8.5.6", "prisma": "^6.19.0", "supertest": "^7.1.4", "tailwindcss": "^3.4.17", "tsx": "^4.20.5", "typescript": "^5.9.2", "vite": "^7.1.3", "vitest": "^3.2.4"
  }
}
